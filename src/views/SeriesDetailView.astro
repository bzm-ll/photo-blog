---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../lib/config';
import { getWorks, getSeriesList, worksOfSeries, type Series } from '../lib/content';
import { href, pick, t, type Lang } from '../lib/i18n';
import { absoluteUrl, imageUrl } from '../lib/seo';

interface Props {
  entry: Series;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const data = entry.data;
const title = pick(lang, data.title_zh, data.title_en);
const subtitle = lang === 'zh' ? data.title_en : data.title_zh;
const description = pick(lang, data.description_zh, data.description_en);
const path = lang === 'zh' ? `/series/${entry.id}/` : `/en/series/${entry.id}/`;

const works = await getWorks();
const items = worksOfSeries(works, entry.id);
const all = await getSeriesList();
const others = all.filter((s) => s.id !== entry.id).slice(0, 3);

const jsonLd = {
  '@type': 'CollectionPage',
  name: title,
  description,
  url: absoluteUrl(path),
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  about: { '@type': 'Thing', name: title },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((work, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absoluteUrl(href(lang, `/works/${work.id}/`)),
      name: pick(lang, work.data.title_zh, work.data.title_en),
      image: imageUrl(work.data.cover),
    })),
  },
};
---

<BaseLayout lang={lang} title={title} description={description || title} path={path} image={data.cover} jsonLd={jsonLd}>
  <header class="container-page pt-12 md:pt-16">
    <nav class="eyebrow" aria-label="Breadcrumb">
      <a href={href(lang, '/series/')} class="hover:text-ink">{t(lang, 'nav.series')}</a>
    </nav>
    <div class="mt-6 grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <h1 class="font-serif text-display">{title}</h1>
        {subtitle && <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute-2">{subtitle}</p>}
        {description && <p class="measure mt-6 text-lg leading-relaxed text-mute">{description}</p>}
      </div>
      <div class="md:col-span-4 md:text-right">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-mute-2">{items.length} {t(lang, 'series.count')} · {site.author[lang]}</p>
      </div>
    </div>
    <div class="mt-10 border-b border-line" />
  </header>

  {data.cover && (
    <figure class="container-page mt-10">
      <div class="max-h-[70vh] overflow-hidden bg-paper-2">
        <Image
          src={data.cover}
          alt={title}
          widths={[640, 960, 1400, 1920]}
          sizes="100vw"
          format="webp"
          quality={82}
          loading="eager"
          class="mx-auto max-h-[70vh] w-full object-cover"
        />
      </div>
    </figure>
  )}

  <section class="container-page py-14 md:py-20">
    <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((work, index) => (
        <WorkCard work={work} lang={lang} priority={index < 3} />
      ))}
    </div>
  </section>

  {others.length > 0 && (
    <section class="container-page border-t border-line py-12">
      <p class="eyebrow mb-6">{t(lang, 'nav.series')}</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {others.map((item) => (
          <li>
            <a href={href(lang, `/series/${item.id}/`)} class="link-underline font-serif text-h3">
              {pick(lang, item.data.title_zh, item.data.title_en)}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
