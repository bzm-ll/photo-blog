---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/config';
import { type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const path = lang === 'zh' ? '/privacy/' : '/en/privacy/';
const title = lang === 'zh' ? '隐私与版权' : 'Privacy & Rights';
const year = new Date().getFullYear();
---

<BaseLayout lang={lang} title={title} description={title} path={path}>
  <div class="container-page pt-12 md:pt-16">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Privacy / Rights</p>
      <h1 class="mt-3 font-serif text-h1">{title}</h1>

      <div class="prose mt-10 measure">
        {lang === 'zh' ? (
          <Fragment>
            <h2>版权</h2>
            <p>本网站内所有摄影作品、文字与版式设计，除另有说明外，著作权均归 {site.author.zh} 所有。</p>
            <p>欢迎在注明作者与来源链接的前提下，于个人博客、社交媒体等非商业场景分享。任何商业用途（包括但不限于广告、印刷出版、图库转售、AI 训练）须事先获得书面许可。</p>
            <h2>隐私</h2>
            <p>本站不使用 Cookie 做访客追踪，不接入第三方广告或统计脚本（如接入，会在此处更新说明）。</p>
            <p>评论功能由 Giscus 提供，评论数据存储在对应的 GitHub Discussions 中。使用评论功能时，你的 GitHub 账号信息会按 Giscus 与 GitHub 的隐私政策处理。</p>
            <p>服务器访问日志由托管平台（Netlify）按其对所有用户统一的政策保存，用于安全与故障排查，本站不单独存储访客数据。</p>
            <h2>联系</h2>
            <p>如需授权、撤下内容或报告错误，请邮件联系：{site.email}</p>
            <p class="text-sm text-mute">最后更新：{year} 年</p>
          </Fragment>
        ) : (
          <Fragment>
            <h2>Copyright</h2>
            <p>All photographs, texts and layout designs on this site are © {site.author.en}, unless stated otherwise.</p>
            <p>You are welcome to share images on personal blogs and social media with credit and a link back. Any commercial use — advertising, print publication, stock resale, or AI training — requires written permission.</p>
            <h2>Privacy</h2>
            <p>This site does not use cookies for visitor tracking and loads no third-party advertising or analytics scripts. If that changes, this page will be updated first.</p>
            <p>Comments are powered by Giscus and stored in GitHub Discussions. When you comment, your GitHub account data is handled under the privacy policies of Giscus and GitHub.</p>
            <p>Server access logs are kept by the hosting provider (Netlify) under its platform-wide policy for security and debugging. This site stores no visitor data of its own.</p>
            <h2>Contact</h2>
            <p>For licensing, takedowns or corrections: {site.email}</p>
            <p class="text-sm text-mute">Last updated: {year}</p>
          </Fragment>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
