---
import BaseLayout from '../layouts/BaseLayout.astro';
import { friends } from '../lib/config';
import { pick, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const path = lang === 'zh' ? '/links/' : '/en/links/';
---

<BaseLayout lang={lang} title={t(lang, 'links.title')} description={t(lang, 'links.intro')} path={path}>
  <div class="container-page pt-12 md:pt-16">
    <div class="border-b border-line pb-8">
      <p class="eyebrow">Links — {friends.length}</p>
      <h1 class="mt-3 font-serif text-h1">{t(lang, 'links.title')}</h1>
      <p class="measure mt-4 text-mute">{t(lang, 'links.intro')}</p>
    </div>
  </div>

  <section class="container-page py-12 md:py-16">
    <ul class="grid gap-px border border-line sm:grid-cols-2 lg:grid-cols-3">
      {friends.map((friend) => (
        <li class="border-b border-r border-line last:border-b-0">
          <a href={friend.url} target="_blank" rel="noopener" class="group flex h-full flex-col justify-between gap-6 p-6 transition-colors hover:bg-paper-2">
            <span class="font-serif text-h3 link-underline">{friend.name}</span>
            <span class="text-sm text-mute">{pick(lang, friend.desc.zh, friend.desc.en)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
