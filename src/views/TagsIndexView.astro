---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWorks, getEssays, tagIndex } from '../lib/content';
import { href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const works = await getWorks();
const essays = await getEssays();
const tags = tagIndex([...works, ...essays] as never, lang);
const path = lang === 'zh' ? '/tags/' : '/en/tags/';
---

<BaseLayout lang={lang} title={t(lang, 'tags.title')} description={t(lang, 'tags.intro')} path={path}>
  <div class="container-page pt-12 md:pt-16">
    <div class="border-b border-line pb-8">
      <p class="eyebrow">Tags — {tags.length}</p>
      <h1 class="mt-3 font-serif text-h1">{t(lang, 'tags.title')}</h1>
      <p class="measure mt-4 text-mute">{t(lang, 'tags.intro')}</p>
    </div>
  </div>

  <section class="container-page py-12 md:py-16">
    {tags.length === 0 ? (
      <p class="text-mute">{t(lang, 'tags.empty')}</p>
    ) : (
      <ul class="flex flex-wrap gap-x-6 gap-y-4">
        {tags.map((tag) => (
          <li>
            <a href={href(lang, `/tags/${encodeURIComponent(tag.slug)}/`)} class="group inline-flex items-baseline gap-2">
              <span class="font-serif text-h2 link-underline">{tag.name}</span>
              <span class="font-mono text-[10px] text-mute-2">{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
