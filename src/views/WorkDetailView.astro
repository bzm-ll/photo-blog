---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import MetaRow from '../components/MetaRow.astro';
import TagList from '../components/TagList.astro';
import PrevNext from '../components/PrevNext.astro';
import Comments from '../components/Comments.astro';
import { site } from '../lib/config';
import { getWorks, getSeriesList, neighbours, type Work } from '../lib/content';
import { formatDate, href, pick, t, type Lang } from '../lib/i18n';
import { md } from '../lib/markdown';
import { absoluteUrl, imageUrl } from '../lib/seo';

interface Props {
  entry: Work;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const data = entry.data;
const title = pick(lang, data.title_zh, data.title_en);
const subtitle = lang === 'zh' ? data.title_en : data.title_zh;
const summary = pick(lang, data.summary_zh, data.summary_en);
const body = md(pick(lang, data.body_zh, data.body_en));
const alt = pick(lang, data.cover_alt_zh, data.cover_alt_en) || title;
const location = pick(lang, data.location_zh, data.location_en);
const tags = ((lang === 'en' ? data.tags_en : data.tags_zh) || []).map((name) => ({ name, slug: name }));
const path = lang === 'zh' ? `/works/${entry.id}/` : `/en/works/${entry.id}/`;
const seoTitle = pick(lang, data.seo_title_zh, data.seo_title_en) || title;
const seoDesc = pick(lang, data.seo_description_zh, data.seo_description_en) || summary;

const works = await getWorks();
const { newer, older } = neighbours(works, entry.id);
const seriesList = await getSeriesList();
const series = seriesList.find((s) => s.id === data.series);
const imageAbs = imageUrl(data.cover);

const jsonLd = [
  {
    '@type': 'ImageObject',
    '@id': absoluteUrl(path) + '#primaryimage',
    contentUrl: imageAbs,
    url: absoluteUrl(path),
    name: title,
    description: seoDesc,
    caption: alt,
    datePublished: new Date(data.date).toISOString(),
    creator: { '@type': 'Person', name: site.author[lang] },
    creditText: site.author[lang],
    copyrightNotice: `© ${new Date(data.date).getUTCFullYear()} ${site.author[lang]}`,
  },
  {
    '@type': 'Article',
    headline: title,
    description: seoDesc,
    image: imageAbs,
    datePublished: new Date(data.date).toISOString(),
    dateModified: new Date(data.date).toISOString(),
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
    author: { '@type': 'Person', name: site.author[lang] },
    publisher: { '@type': 'Person', name: site.author[lang] },
    mainEntityOfPage: absoluteUrl(path),
    articleSection: series ? pick(lang, series.data.title_zh, series.data.title_en) : t(lang, 'nav.works'),
    keywords: (lang === 'en' ? data.tags_en : data.tags_zh).join(', '),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(lang, 'nav.home'), item: absoluteUrl(href(lang, '/')) },
      { '@type': 'ListItem', position: 2, name: t(lang, 'nav.works'), item: absoluteUrl(href(lang, '/works/')) },
      { '@type': 'ListItem', position: 3, name: title, item: absoluteUrl(path) },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  title={seoTitle}
  description={seoDesc}
  path={path}
  image={data.cover}
  type="article"
  publishedTime={data.date}
  jsonLd={jsonLd}
>
  <article>
    <header class="container-page pt-12 md:pt-16">
      <nav class="eyebrow flex items-center gap-2" aria-label="Breadcrumb">
        <a href={href(lang, '/works/')} class="hover:text-ink">{t(lang, 'nav.works')}</a>
        <span>/</span>
        <span class="text-mute-2">{new Date(data.date).getUTCFullYear()}</span>
      </nav>

      <h1 class="mt-5 max-w-5xl font-serif text-display">{title}</h1>
      {subtitle && <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute-2">{subtitle}</p>}
      {summary && <p class="measure mt-6 text-lg leading-relaxed text-mute">{summary}</p>}

      <div class="mt-10">
        <MetaRow
          lang={lang}
          published={formatDate(lang, data.date)}
          shotAt={data.shot_at}
          location={location}
          camera={data.camera}
          lens={data.lens}
        />
      </div>
    </header>

    <figure class="mt-10 w-full bg-paper-2 md:mt-14">
      <Image
        src={data.cover}
        alt={alt}
        widths={[640, 960, 1400, 1920]}
        sizes="100vw"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="mx-auto max-h-[86vh] w-full object-contain"
      />
      {alt && <figcaption class="container-page py-3 text-xs text-mute-2">{alt}</figcaption>}
    </figure>

    <div class="container-page mt-14 md:mt-20">
      <div class="grid gap-10 md:grid-cols-12">
        <aside class="md:col-span-3">
          <div class="md:sticky md:top-24">
            {series && (
              <div class="mb-8">
                <p class="eyebrow mb-3">{t(lang, 'post.series')}</p>
                <a href={href(lang, `/series/${series.id}/`)} class="link-underline font-serif text-lg">
                  {pick(lang, series.data.title_zh, series.data.title_en)}
                </a>
              </div>
            )}
            {tags.length > 0 && (
              <div>
                <p class="eyebrow mb-3">{t(lang, 'post.tags')}</p>
                <TagList tags={tags} lang={lang} />
              </div>
            )}
          </div>
        </aside>

        <div class="md:col-span-9">
          {body ? <div class="prose measure" set:html={body} /> : <p class="text-mute">—</p>}
        </div>
      </div>

      {data.gallery.length > 0 && <Gallery items={data.gallery} lang={lang} />}

      <PrevNext
        lang={lang}
        base="/works"
        newer={newer ? { id: newer.id, title: pick(lang, newer.data.title_zh, newer.data.title_en) } : null}
        older={older ? { id: older.id, title: pick(lang, older.data.title_zh, older.data.title_en) } : null}
      />

      <Comments lang={lang} />
    </div>
  </article>
</BaseLayout>
