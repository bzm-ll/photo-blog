---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const path = lang === 'zh' ? '/404/' : '/en/404/';
---

<BaseLayout lang={lang} title={t(lang, 'notfound.title')} description={t(lang, 'notfound.desc')} path={path} noindex>
  <div class="container-page flex min-h-[60vh] flex-col justify-center py-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-mute-2">Error 404</p>
    <h1 class="mt-6 font-serif text-display">{t(lang, 'notfound.title')}</h1>
    <p class="measure mt-6 text-mute">{t(lang, 'notfound.desc')}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={href(lang, '/')} class="btn">{t(lang, 'notfound.home')}</a>
      <a href={href(lang, '/works/')} class="btn btn-ghost">{t(lang, 'nav.works')}</a>
    </div>
  </div>
</BaseLayout>
