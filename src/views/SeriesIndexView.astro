---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getWorks, getSeriesList, worksOfSeries } from '../lib/content';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const works = await getWorks();
const seriesList = await getSeriesList();
const path = lang === 'zh' ? '/series/' : '/en/series/';
---

<BaseLayout lang={lang} title={t(lang, 'series.title')} description={t(lang, 'series.intro')} path={path}>
  <div class="container-page pt-12 md:pt-16">
    <div class="border-b border-line pb-8">
      <p class="eyebrow">Projects — {seriesList.length}</p>
      <h1 class="mt-3 font-serif text-h1">{t(lang, 'series.title')}</h1>
      <p class="measure mt-4 text-mute">{t(lang, 'series.intro')}</p>
    </div>
  </div>

  <section class="container-page py-12 md:py-16">
    <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {seriesList.map((item) => (
        <SeriesCard series={item} lang={lang} count={worksOfSeries(works, item.id).length} cover={item.data.cover ?? null} />
      ))}
    </div>
  </section>
</BaseLayout>
