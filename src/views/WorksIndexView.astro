---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../lib/config';
import { getWorks, getSeriesList } from '../lib/content';
import { href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const works = await getWorks();
const seriesList = await getSeriesList();
const path = lang === 'zh' ? '/works/' : '/en/works/';
---

<BaseLayout lang={lang} title={t(lang, 'works.title')} description={t(lang, 'works.intro')} path={path}>
  <div class="container-page pt-12 md:pt-16">
    <div class="grid gap-6 border-b border-line pb-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="eyebrow">Index — {works.length} works</p>
        <h1 class="mt-3 font-serif text-h1">{t(lang, 'works.title')}</h1>
        <p class="measure mt-4 text-mute">{t(lang, 'works.intro')}</p>
      </div>
      <nav class="md:col-span-4 md:text-right" aria-label="Series">
        <a href={href(lang, '/series/')} class="link-underline font-mono text-[11px] uppercase tracking-[0.14em] text-mute hover:text-ink">
          {t(lang, 'nav.series')} ({seriesList.length}) →
        </a>
      </nav>
    </div>
  </div>

  <section class="container-page py-12 md:py-16">
    {works.length === 0 ? (
      <p class="py-16 text-center text-mute">{t(lang, 'works.empty')}</p>
    ) : (
      <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {works.map((work, index) => (
          <WorkCard work={work} lang={lang} priority={index < 3} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
