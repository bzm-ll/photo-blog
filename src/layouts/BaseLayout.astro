---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, t, type Lang } from '../lib/i18n';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  path: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, path, image, type, noindex, publishedTime, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG[lang]} class="h-full">
  <head>
    <BaseHead
      lang={lang}
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      jsonLd={jsonLd}
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="flex min-h-full flex-col bg-paper text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:text-sm focus:text-paper"
    >{lang === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>

    <Header lang={lang} />

    <main id="main" class="flex-1" data-pagefind-body data-pagefind-filter={`locale:${lang}`}>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
