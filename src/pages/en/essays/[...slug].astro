---
import EssayDetailView from '../../../views/EssayDetailView.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('essays', ({ data }) => data.draft !== true);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<EssayDetailView entry={entry} lang="en" />
