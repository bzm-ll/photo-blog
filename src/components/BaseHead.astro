---
import type { ImageMetadata } from 'astro';
import { site } from '../lib/config';
import { HTML_LANG, OG_LOCALE, sibling, type Lang } from '../lib/i18n';
import { absoluteUrl, clamp, DEFAULT_OG, imageUrl } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** 当前页面路径，如 /works/fog-harbour/ */
  path: string;
  image?: ImageMetadata | string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = '',
  lang,
  path,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const siteName = site.name[lang];
const fullTitle = path === '/' || path === '/en/' ? `${siteName} — ${site.tagline[lang]}` : `${title} — ${siteName}`;
const desc = clamp(description || site.tagline[lang], 160);
const ogImage =
  typeof image === 'string' ? absoluteUrl(image) : imageUrl(image) ?? absoluteUrl(DEFAULT_OG);
const canonical = absoluteUrl(path);
const alt = sibling(lang, path);
const altZh = alt.lang === 'zh' ? alt.path : path;
const altEn = alt.lang === 'en' ? alt.path : path;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<!-- 语言版本互相指向，避免重复内容 -->
<link rel="alternate" hreflang="zh-CN" href={absoluteUrl(altZh)} />
<link rel="alternate" hreflang="en" href={absoluteUrl(altEn)} />
<link rel="alternate" hreflang="x-default" href={absoluteUrl(altZh)} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:locale:alternate" content={alt.lang === 'zh' ? OG_LOCALE.zh : OG_LOCALE.en} />
{publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0d0d0c" media="(prefers-color-scheme: dark)" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- 结构化数据：Person + WebSite（每页都有，帮助搜索引擎理解这是谁、这是什么站） -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': absoluteUrl('/#person'),
        name: site.author[lang],
        url: absoluteUrl('/'),
        email: site.email,
        sameAs: site.social.filter((s) => s.href.startsWith('http')).map((s) => s.href),
      },
      {
        '@type': 'WebSite',
        '@id': absoluteUrl('/#website'),
        url: absoluteUrl('/'),
        name: siteName,
        inLanguage: HTML_LANG[lang],
        publisher: { '@id': absoluteUrl('/#person') },
        potentialAction: {
          '@type': 'SearchAction',
          target: absoluteUrl('/search/') + '?q={search_term_string}',
          'query-input': 'required name=search_term_string',
        },
      },
    ],
  })}
/>

{blocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...block })} />
))}
