---
import { Image } from 'astro:assets';
import type { Series } from '../lib/content';
import { href, pick, t, type Lang } from '../lib/i18n';

interface Props {
  series: Series;
  lang: Lang;
  count: number;
  cover?: ImageMetadata | null;
}
const { series, lang, count, cover } = Astro.props;
const title = pick(lang, series.data.title_zh, series.data.title_en);
---

<article class="group">
  <a href={href(lang, `/series/${series.id}/`)} class="block">
    <div class="img-zoom aspect-[4/5] overflow-hidden bg-paper-2">
      {cover ? (
        <Image
          src={cover}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw"
          format="webp"
          quality={82}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="flex h-full items-center justify-center font-serif text-3xl text-mute-2">{title.slice(0, 1)}</div>
      )}
    </div>
    <div class="mt-4 flex items-baseline justify-between gap-3">
      <h3 class="font-serif text-h3"><span class="link-underline">{title}</span></h3>
      <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.12em] text-mute-2">{count} {t(lang, 'series.count')}</span>
    </div>
  </a>
</article>
