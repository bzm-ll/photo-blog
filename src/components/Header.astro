---
import { site, nav } from '../lib/config';
import { href, sibling, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '/') || '/';
const alt = sibling(lang, Astro.url.pathname);
const isActive = (path: string) => {
  const target = href(lang, path);
  return target !== href(lang, '/') && pathname.startsWith(target);
};
const homeHref = href(lang, '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md no-print">
  <div class="container-page flex h-14 items-center justify-between gap-6 md:h-16">
    <a href={homeHref} class="group flex items-baseline gap-2" aria-label={site.name[lang]}>
      <span class="font-serif text-lg tracking-[0.02em] md:text-xl">{site.name[lang]}</span>
      <span class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-mute sm:inline">
        Photography
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={href(lang, item.path)}
          class:list={[
            'font-mono text-[11px] uppercase tracking-[0.16em] transition-colors',
            isActive(item.path) ? 'text-ink' : 'text-mute hover:text-ink',
          ]}
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          {t(lang, item.key as never)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={href(lang, '/search/')}
        class="flex h-11 w-11 items-center justify-center text-mute transition-colors hover:text-ink"
        aria-label={t(lang, 'nav.search')}
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>

      <a
        href={alt.path}
        hreflang={alt.lang}
        class="font-mono text-[11px] uppercase tracking-[0.14em] text-mute transition-colors hover:text-ink"
        aria-label={lang === 'zh' ? 'Switch to English' : '切换到中文'}
      >{lang === 'zh' ? 'EN' : '中文'}</a>

      <button
        type="button"
        id="theme-toggle"
        class="flex h-11 w-11 items-center justify-center text-mute transition-colors hover:text-ink"
        aria-label={t(lang, 'theme.toggle')}
      >
        <svg class="block dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(lang, 'menu.open')}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-line bg-paper md:hidden">
    <nav class="container-page flex flex-col py-2" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={href(lang, item.path)}
          class="flex min-h-12 items-center justify-between border-b border-line/60 py-3 text-sm last:border-0"
        >
          <span>{t(lang, item.key as never)}</span>
          <span class="font-mono text-[10px] text-mute-2">{item.path}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('menu-toggle');
    var panel = document.getElementById('mobile-nav');
    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        var open = panel.hasAttribute('hidden');
        if (open) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', String(open));
      });
    }
    var themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var root = document.documentElement;
        var dark = root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch (e) {}
        var giscus = document.querySelector('iframe.giscus-frame');
        if (giscus && giscus.contentWindow) {
          giscus.contentWindow.postMessage(
            { giscus: { setConfig: { theme: dark ? 'dark' : 'light' } } },
            'https://giscus.app'
          );
        }
      });
    }
  })();
</script>
